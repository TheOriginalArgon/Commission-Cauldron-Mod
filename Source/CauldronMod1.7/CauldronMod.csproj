<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Build each game against its own runtime and pinned API reference. -->
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.6'">net48</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <RimWorldReferenceVersion Condition="'$(RimWorldVersion)' == '1.6'">1.6.4871</RimWorldReferenceVersion>
    <RimWorldReferenceVersion Condition="'$(RimWorldVersion)' == '1.7'">1.7.4982-unstable</RimWorldReferenceVersion>
    <AssemblyName>CauldronMod</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldReferenceVersion)" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
  <!-- A successful release build updates only the selected game's shipped DLL. -->
  <Target Name="DeployModAssembly" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/../../$(RimWorldVersion)/Assemblies" />
  </Target>
</Project>
